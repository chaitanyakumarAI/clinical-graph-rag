# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ── Databases ────────────────────────────────────────────────────────────────
# docker compose uses NEO4J_PASSWORD to create the Neo4j user (min 8 chars).
# For local runs without Docker, point these at your own Neo4j / Qdrant.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=medical_chunks

# Optional Neo4j Graph Data Science plugin (docker compose only)
# NEO4J_PLUGINS=["graph-data-science"]

# ── LLM provider: set ONE key (auto-detected in the order Gemini → Groq → OpenAI)
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Or a local model with no rate limits:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# Force a provider instead of auto-detecting: gemini | groq | openai | ollama
# LLM_PROVIDER=

# ── Model choice and rate limits (per provider: GROQ_, GEMINI_, OPENAI_, OLLAMA_)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TPM=8000          # tokens/minute your account allows
# GROQ_RPM=30            # requests/minute
# EXTRACTION_MODEL=      # separate model for bulk PDF extraction
# EXTRACTION_MAX_TOKENS=2048
# LLM_REASONING_EFFORT=low
# LLM_MAX_WAIT_SECONDS=120

# ── Retrieval ────────────────────────────────────────────────────────────────
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# CYPHER_TIMEOUT_SECONDS=10   # server-side timeout for LLM-generated Cypher

# ── Optional identifier linking ──────────────────────────────────────────────
# UMLS_API_KEY=
